+<?php
+
+namespace app\commands;
+
+use app\modules\ejadmin\models\SnSiiManage;
+use yii\console\Controller;
+use yii\console\ExitCode;
+
+/**
+ * 持久登录密钥轮换辅助命令。
+ *
+ * 用法：MORRISHK_AUTH_KEY_SECRET=<新 Secret> php yii auth-key/rotate
+ * 必须在每次更换或回滚 Secret 后执行，使该账号的全部旧 Cookie 永久失效。
+ */
+class AuthKeyController extends Controller
+{
+    /**
+     * 将全部账号的 AuthKeyVersion +1，吊销所有已签发的持久登录 Cookie。
+     * @return int
+     */
+    public function actionRotate()
+    {
+        try {
+            $affected = SnSiiManage::bumpAllAuthKeyVersions();
+        } catch (\Throwable $e) {
+            $this->stderr("auth-key rotation failed: " . $e->getMessage() . "\n");
+            return ExitCode::UNSPECIFIED_ERROR;
+        }
+        $this->stdout("AuthKeyVersion incremented for {$affected} account(s).\n");
+        return ExitCode::OK;
+    }
+}
