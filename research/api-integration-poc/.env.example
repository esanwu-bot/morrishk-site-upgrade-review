# 运行模式：mock（默认）| real
POC_MODE=mock

# 真实发布总开关：默认关闭。即使开启，也必须在命令中显式加 --confirm-publish
ALLOW_REAL_PUBLISH=false
# 真实发布目标白名单，逗号分隔，格式 provider:platform:account
# 例：ayrshare:linkedin:morrishk-page,linkedin:linkedin:1001
PUBLISH_TARGET_ALLOWLIST=

# GA4 Measurement Protocol 真实写入独立开关（不继承社媒发布授权）
ALLOW_REAL_MP=false

# ---- 聚合 API（Ayrshare）----
AYRSHARE_API_KEY=
AYRSHARE_BASE_URL=https://api.ayrshare.com

# ---- LinkedIn 官方 API ----
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8787/callback/linkedin
# 组织主页 author URN（二选一）或 organization id
LINKEDIN_AUTHOR_URN=
LINKEDIN_ORGANIZATION_ID=

# ---- Mux 视频托管 ----
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# ---- GA4 ----
# 服务账号 JSON 文件路径（不要提交该文件）
GOOGLE_APPLICATION_CREDENTIALS=
# 也可直接用短期 access token 验证
GOOGLE_ACCESS_TOKEN=
GA4_PROPERTY_ID=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# 本地 token 存储目录
POC_TOKEN_DIR=./.tokens

# 日志级别：debug | info | warn | error
LOG_LEVEL=info
